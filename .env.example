# Copy this file to .env and fill in real values. .env is gitignored and never committed.

DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# 32-byte hex key used to encrypt guest ID numbers at rest. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Valor Connect credentials (from the ISV/Valor merchant portal). If unset,
# the app falls back to the fake/simulated terminal automatically.
VALOR_EPI=""
VALOR_APP_ID=""
VALOR_APP_KEY=""
VALOR_CHANNEL_ID=""
